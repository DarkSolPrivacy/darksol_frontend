HELIUS_API_KEY=your_helius_api_key
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your_alchemy_api_key
PORT=8787
DATABASE_PATH=data/cloak-analytics.sqlite
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
TEST_WALLETS_DIR=test-wallets
CURVY_API_URL=https://api.curvy.box

# Supabase (Connect -> Direct connection locally, Transaction pooler on Vercel).
# The server talks to Postgres over this URL, so no anon/service-role key is
# needed. A password containing punctuation is percent-encoded automatically;
# one containing "/" or "@" must be encoded by hand.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Days of pool_flows history to retain. The dashboard's longest range is 90
# days; older flows are folded into flow_baselines so pool balances stay exact.
# FLOW_RETENTION_DAYS=100
