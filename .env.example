HELIUS_API_KEY=your_helius_api_key
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your_alchemy_api_key
PORT=8787
DATABASE_PATH=data/cloak-analytics.sqlite
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
TEST_WALLETS_DIR=test-wallets
CURVY_API_URL=https://api.curvy.box

# Supabase (Connect -> Direct connection). The server talks to Postgres over
# this URL, so no anon/service-role key is needed.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Optional: skip the raw transaction payloads (~95% of the dataset's bytes,
# unread by the dashboard) to keep the hosted database small.
# SUPABASE_SKIP_PAYLOADS=1
