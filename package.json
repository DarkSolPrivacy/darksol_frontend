{
  "name": "darksol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-privacycash-wasm.js",
    "dev": "node scripts/check-node-version.js && concurrently -k -n api,web -c green,cyan \"node --watch server/api.js\" \"vite\"",
    "dev:api": "node scripts/check-node-version.js && node --watch server/api.js",
    "indexer": "node scripts/check-node-version.js && node server/indexer.js",
    "indexer:watch": "node scripts/check-node-version.js && node server/indexer.js --watch 300",
    "indexer:dev": "node scripts/check-node-version.js && node server/indexer.js --dev",
    "indexer:dev:watch": "node scripts/check-node-version.js && node server/indexer.js --dev --watch 30",
    "migrate": "node scripts/check-node-version.js && node server/migrate.js",
    "wallets:create": "tsx scripts/private-sol.ts wallets:create",
    "protocol:check": "tsx scripts/private-sol.ts check all",
    "protocol:snapshot": "tsx scripts/private-sol.ts snapshot",
    "protocol:balance": "tsx scripts/private-sol.ts balance",
    "protocol:estimate": "tsx scripts/private-sol.ts estimate",
    "protocol:deposit": "tsx scripts/private-sol.ts deposit",
    "protocol:send": "tsx scripts/private-sol.ts send",
    "protocol:swap": "tsx scripts/private-sol.ts swap",
    "curvy:register": "tsx scripts/private-sol.ts curvy:register",
    "curvy:auth-diagnostic": "tsx scripts/private-sol.ts curvy:auth-diagnostic",
    "curvy:portal-status": "tsx scripts/private-sol.ts curvy:portal-status",
    "curvy:recover": "tsx scripts/private-sol.ts curvy:recover",
    "test": "node --import tsx --test",
    "build": "vite build",
    "preview": "node scripts/check-node-version.js && node server/api.js",
    "start": "node scripts/check-node-version.js && node server/api.js"
  },
  "dependencies": {
    "@0xcurvy/curvy-sdk": "^0.0.8-rc.1",
    "@cloak.dev/sdk": "^0.2.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@vitejs/plugin-react": "latest",
    "bs58": "^6.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "lucide-react": "latest",
    "privacycash": "^1.2.2",
    "react": "latest",
    "react-dom": "latest",
    "react-is": "latest",
    "recharts": "latest",
    "three": "^0.185.1",
    "vite": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
