{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/docs/", "destination": "/docs/index.html" },
    { "source": "/admin-stats", "destination": "https://api.darksol.app/admin-stats" },
    { "source": "/admin-stats/:path*", "destination": "https://api.darksol.app/admin-stats/:path*" },
    { "source": "/api/solana-rpc", "destination": "https://api.darksol.app/api/solana-rpc?k=af77cc9602ddd1884fcc8f65258848b4" },
    { "source": "/api/:path*", "destination": "https://api.darksol.app/api/:path*" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/analytics", "destination": "/analytics.html" },
    { "source": "/payment-links", "destination": "/payment-links.html" },
    { "source": "/trace", "destination": "/trace.html" },
    { "source": "/trace/:path*", "destination": "/trace.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
